{
  "name": "sports-event-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/infrastructure/persistence/cli.ts migrate",
    "seed": "node --env-file-if-exists=.env src/infrastructure/persistence/cli.ts seed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:domain": "vitest run --project domain",
    "test:persistence": "vitest run --project persistence",
    "test:api": "vitest run --project api",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "kysely": "^0.29.9",
    "pg": "^8.23.1"
  }
}
